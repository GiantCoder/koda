# Base URL the mobile app talks to. This is the SAME Next.js API the web app
# (../app/api/**) already serves — nothing mobile-specific runs on the backend.
#
# - iOS Simulator / Android Emulator: "http://localhost:3050" works (both proxy
#   localhost back to your Mac, where `npm run dev` is listening on :3050).
# - A physical phone via Expo Go: localhost means the PHONE, not your Mac, so
#   this must be your Mac's LAN IP instead, e.g. "http://192.168.1.23:3050"
#   (find it with `ipconfig getifaddr en0` on macOS). Phone and Mac must be on
#   the same Wi-Fi network.
EXPO_PUBLIC_API_URL=http://localhost:3050
