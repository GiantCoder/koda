# Base URL the mobile app talks to. This is the SAME Next.js API the web app
# (../app/api/**) already serves — nothing mobile-specific runs on the backend.
#
# Port depends on how you run the backend:
# - `make up` / docker compose: host port 3005
# - `npm run dev` on the host: port 3050
#
# Host depends on the client:
# - iOS Simulator / Android Emulator: localhost works (both proxy back to your Mac)
# - A physical phone via Expo Go: localhost means the PHONE, so this must be
#   your Mac's LAN IP instead, e.g. "http://192.168.1.23:3005"
#   (find it with `ipconfig getifaddr en0` on macOS). Phone and Mac must be on
#   the same Wi-Fi network. After changing this file, restart with
#   `npx expo start -c`.
EXPO_PUBLIC_API_URL=http://localhost:3005
