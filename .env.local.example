# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api

# Database
DATABASE_URL=mysql://koda:secret@mysql:3306/kodacricket
SHADOW_DATABASE_URL=mysql://root:rootsecret@mysql:3306/kodacricket_shadow

# Redis
REDIS_URL=redis://redis:6379

# Storage (MinIO in dev, S3 in prod)
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=eu-west-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_VIDEOS=koda-videos
STORAGE_BUCKET_ASSETS=koda-assets
STORAGE_PUBLIC_URL=http://localhost:9000

# JWT
JWT_PRIVATE_KEY=replace-with-rs256-private-key
JWT_PUBLIC_KEY=replace-with-rs256-public-key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# LLM APIs
GOOGLE_API_KEY=replace-me
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CLASSIFICATION_MODEL=gemini-2.5-flash
GEMINI_SCORING_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=replace-me
ANTHROPIC_API_KEY=replace-me

# LangFuse
LANGFUSE_HOST=http://langfuse:3100
LANGFUSE_PUBLIC_KEY=replace-me
LANGFUSE_SECRET_KEY=replace-me

# Email
RESEND_API_KEY=replace-me
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=noreply@koda.local

# OAuth
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
APPLE_CLIENT_ID=replace-me
APPLE_CLIENT_SECRET=replace-me

# MediaPipe Service
MEDIAPIPE_SERVICE_URL=http://mediapipe:8001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Feature Flags
FEATURE_ENABLE_UPLOADS=true
FEATURE_ENABLE_MESSAGING=true
FEATURE_ENABLE_ANALYSIS=true

# ECB / Play-Cricket Integration
# Generate with: openssl rand -hex 32
ECB_API_KEY_SECRET=your_64_char_hex_secret_here
# Optional: ECB API docs URL for "Learn more" link in Settings
NEXT_PUBLIC_ECB_API_DOCS_URL=https://play-cricket.ecb.co.uk/hc/en-us/sections/360000978518-API-Experienced-Developers-Only
