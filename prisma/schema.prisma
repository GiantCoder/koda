generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLAYER
  PARENT
  COACH
  ADMIN
}

enum ConsentStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_REQUIRED
}

enum AnalysisStatus {
  QUEUED
  EXTRACTING_FRAMES
  POSE_ANALYSIS
  SHOT_CLASSIFICATION
  GENERATING_FEEDBACK
  COMPLETE
  FAILED
}

enum ShotType {
  COVER_DRIVE
  OFF_DRIVE
  STRAIGHT_DRIVE
  ON_DRIVE
  SWEEP
  REVERSE_SWEEP
  PULL
  HOOK
  CUT
  GLANCE
  DEFENSIVE
  LATE_CUT
  FLICK
  SCOOP
  UNKNOWN
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?
  name         String?
  displayName  String  @default("")
  firstName    String?
  lastName     String?
  role         Role      @default(PLAYER)
  dateOfBirth  DateTime?
  ageGroup     String?
  clubOrSchool String?
  primaryPosition String?
  battingStyle String?
  bowlingStyle String?
  profileVisibility String @default("COACHES_PARENTS")
  isActive     Boolean   @default(true)
  emailVerified Boolean  @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  consentRecord      ConsentRecord?
  privacyPreferences PrivacyPreferences?
  videos             Video[]
}

model Video {
  id              String    @id @default(uuid())
  userId          String
  filename        String
  originalFormat  String
  storagePath     String
  cdnUrl          String?
  fileSizeBytes   BigInt
  durationSeconds Float?
  resolutionWidth Int?
  resolutionHeight Int?
  uploadedAt      DateTime  @default(now())
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis Analysis?

  @@index([userId])
}

model Analysis {
  id                   String         @id @default(uuid())
  videoId              String         @unique
  status               AnalysisStatus @default(QUEUED)
  shotType             ShotType?
  shotConfidence       Float?
  gradeOverall         Float?
  gradeLetter          String?
  scoreBacklift        Float?
  scoreWeightTransfer  Float?
  scoreHeadPosition    Float?
  scoreFollowThrough   Float?
  scoreTiming          Float?
  scoreBalance         Float?
  scoreFootwork        Float?
  scoreShotSelection   Float?
  poseDataPath         String?
  skeletonOverlayPath  String?
  coachingTips        Json?
  rawGeminiResponse   Json?
  rawOpenAiResponse   Json?
  analysisVersion     String         @default("1.0")
  processingMs        Int?
  errorMessage        String?        @db.Text
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([status])
}

model ConsentRecord {
  id                    String        @id @default(uuid())
  userId                String        @unique
  guardianName          String?
  guardianEmail         String?
  guardianRelationship  String?
  consentStatus        ConsentStatus @default(PENDING)
  verificationToken    String?       @unique
  tokenExpiresAt       DateTime?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PrivacyPreferences {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  performanceAnalytics    Boolean  @default(true)
  marketingCommunications Boolean  @default(false)
  coachParentComms        Boolean  @default(true)
  profileVisibility       String   @default("COACHES_PARENTS")
  consentVersion          String   @default("1.0")
  consentedAt             DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
