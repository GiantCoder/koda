generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  PLAYER
  PARENT
  COACH
  ADMIN
}

enum ConsentStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_REQUIRED
}

enum AnalysisStatus {
  QUEUED
  EXTRACTING_FRAMES
  ACTIVITY_CLASSIFICATION
  POSE_ANALYSIS
  SHOT_CLASSIFICATION
  GENERATING_FEEDBACK
  COMPLETE
  FAILED
  UNSUPPORTED_CONTENT
}

enum ShotType {
  COVER_DRIVE
  OFF_DRIVE
  STRAIGHT_DRIVE
  ON_DRIVE
  SWEEP
  REVERSE_SWEEP
  PULL
  HOOK
  CUT
  GLANCE
  DEFENSIVE
  LATE_CUT
  FLICK
  SCOOP
  FORWARD_DEFENCE
  BACK_FOOT_DEFENCE
  LEG_GLANCE
  SQUARE_CUT
  UPPER_CUT
  LOFTED_DRIVE
  PADDLE_SWEEP
  RAMP
  CHECK_DRIVE
  LEAVE
  UNKNOWN
}

enum MessageVisibility {
  STANDARD
  PARENT_VISIBLE
  COACH_ONLY
}

enum AgeGroup {
  UNDER_10
  UNDER_12
  UNDER_14
  UNDER_16
  UNDER_18
  SENIOR
}

enum NotificationType {
  ANALYSIS_COMPLETE
  NEW_MESSAGE
  TEAM_INVITATION
  ACHIEVEMENT_UNLOCKED
  SESSION_REMINDER
  CONSENT_REQUEST
  SYSTEM_ALERT
  CARD_STAT_UPDATE
  LEAGUE_POSITION_CHANGE
  SEASON_ENDING
  SEASON_COMPLETE
  CHALLENGE_LIVE
  CHALLENGE_RESULT
}

enum LeagueScope {
  CLUB
  CUSTOM
  GLOBAL
}

enum BadgeRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

/// Whether players earn points from upload analyses, shadow batting, or both.
enum PointEarnSource {
  UPLOADS_ONLY
  SHADOW_BATTING_ONLY
  BOTH
}

enum ChallengeStatus {
  DRAFT
  ACTIVE
  JUDGING
  COMPLETE
  CANCELLED
}

enum CardTier {
  BRONZE
  SILVER
  GOLD
  ELITE
}

enum CardRole {
  BAT
  BWL
  ALL
  WKT
}

enum SportIcon {
  BAT_ICON
  BALL_ICON
  GLOVES_ICON
}

enum BgMode {
  DEFAULT
  UPLOAD
  AI
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?
  name         String?
  displayName  String  @default("")
  firstName    String?
  lastName     String?
  avatarUrl    String?
  role         Role      @default(PLAYER)
  dateOfBirth  DateTime?
  ageGroup     String?
  clubOrSchool String?
  primaryPosition String?
  battingStyle String?
  bowlingStyle String?
  profileVisibility String @default("COACHES_PARENTS")
  isActive     Boolean   @default(true)
  emailVerified Boolean  @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  // ECB / Play-Cricket integration (coaches only)
  ecbApiKeyEncrypted  String?   // AES-256-GCM ciphertext (hex)
  ecbApiKeyIv         String?   // 12-byte IV (hex)
  ecbApiKeyTag        String?   // 16-byte GCM auth tag (hex)
  ecbApiKeyVerifiedAt DateTime? // set when the key passes validation
  playCricketPersonId String?   // Play-Cricket person ID (players only)

  consentRecord      ConsentRecord?
  privacyPreferences PrivacyPreferences?
  videos             Video[]
  parentLinks        GuardianLink[] @relation("ParentLinks")
  childLinks         GuardianLink[] @relation("ChildLinks")
  sentMessages       Message[]      @relation("SentMessages")
  conversationParticipants ConversationParticipant[]
  auditLogs          AuditLog[]
  squadMemberships   SquadMember[]
  coachSquads        Squad[]
  coachClubs         Club[]
  sessions           Session[]      @relation("PlayerSessions")
  coachSessions      Session[]     @relation("CoachSessions")
  annotationsAuthored Annotation[] @relation("AnnotationAuthor")
  collections        Collection[]
  collectionsSharedWithMe CollectionShare[] @relation("CollectionSharesRecipient")
  collectionSharesSent    CollectionShare[] @relation("CollectionSharesSender")
  notifications      Notification[]
  playerCard         PlayerCard?
  userPoints         UserPoints?
  userBadges         UserBadge[]
  leagueMemberships  LeagueMember[]
  leagueEntries      LeagueEntry[]
  challengeSubmissions ChallengeSubmission[]
  createdLeagues     League[]              @relation("CreatedLeagues")
  createdChallenges  Challenge[]           @relation("CreatedChallenges")
  coachPlayCricketImports  PlayCricketImport[]    @relation("CoachPlayCricketImports")
  linkedPlayCricketImports PlayCricketImport[]    @relation("LinkedPlayCricketImports")
  coachPlayCricketStats    PlayCricketPlayerStats[] @relation("CoachPlayCricketStats")
  coachPlayCricketMatches  PlayCricketMatch[]    @relation("CoachPlayCricketMatches")
  coachSyncLogs            PlayCricketSyncLog[]   @relation("CoachSyncLogs")
  coachInviteTokens       PlayCricketInviteToken[] @relation("CoachInviteTokens")
  pushTokens              PushToken[]
}

model Video {
  id              String    @id @default(uuid())
  userId          String
  filename        String
  originalFormat  String
  storagePath     String
  cdnUrl          String?
  fileSizeBytes   BigInt
  durationSeconds Float?
  resolutionWidth Int?
  resolutionHeight Int?
  uploadedAt      DateTime  @default(now())
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  /// Coach/user-editable freeform tags (JSON string[]). Null/empty = no tags.
  tags            Json?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis   Analysis?
  savedClips SavedClip[]

  @@index([userId])
}

model Analysis {
  id                   String         @id @default(uuid())
  videoId              String         @unique
  status               AnalysisStatus @default(QUEUED)
  shotType             ShotType?
  shotConfidence       Float?
  gradeOverall         Float?
  gradeLetter          String?
  scoreBacklift        Float?
  scoreWeightTransfer  Float?
  scoreHeadPosition    Float?
  scoreFollowThrough   Float?
  scoreTiming          Float?
  scoreBalance         Float?
  scoreFootwork        Float?
  scoreShotSelection   Float?
  /// Bowling arm, when activityType == BOWLING (e.g. "RIGHT_ARM" | "LEFT_ARM")
  bowlingArm            String?
  /// Bowling type, when activityType == BOWLING (e.g. "PACE" | "SPIN")
  bowlingType           String?
  /// Best-effort delivery variation classification (e.g. "GOOD_LENGTH", "YORKER", "OFF_BREAK"); low confidence expected
  deliveryType          String?
  deliveryConfidence    Float?
  scoreRunUpRhythm      Float?
  scoreLoadUp           Float?
  scoreBowlingArmAction Float?
  scoreDeliveryStride   Float?
  scoreReleasePoint     Float?
  scoreAlignment        Float?
  /// Optional label from the player (e.g. shadow batting shot picker); used as a soft prior for LLM.
  playerDeclaredShotType String?
  /// Dashboard upload only: how many distinct strokes the user believes are in the clip (1+).
  declaredShotCount       Int?
  /// Upload flow: chronological shot-type hints per stroke (enum strings; may include UNKNOWN). Json string[].
  playerDeclaredShotHints Json?
  /// Activity detected by the vision gate (BATTING | BOWLING | FIELDING | GYM | UNCLEAR)
  activityType        String?
  /// Coach/user override for reprocessing (e.g. "BATTING") — forces that pipeline branch.
  activityOverride    String?
  /// Confidence score from activity gate (0.0–1.0)
  activityConfidence  Float?
  /// Human-readable reason shown on the UI when activityType !== BATTING
  rejectionReason     String?        @db.Text
  poseDataPath         String?
  /// Manifest of persisted analysis frames: [{ index, timestampMs, storageKey }, ...]. Null for analyses processed before this shipped.
  frameManifest        Json?
  skeletonOverlayPath  String?
  coachingTips        Json?
  /// Per-dimension grounded feedback from Gemini scoring: TechniqueFeedbackItem[] (batting or bowling; discriminate via activityType).
  technicalFeedback   Json?
  rawGeminiResponse   Json?
  rawOpenAiResponse   Json?
  analysisVersion     String         @default("1.0")
  processingMs        Int?
  errorMessage        String?        @db.Text
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  annotations Annotation[]

  @@index([status])
}

model Annotation {
  id          String   @id @default(uuid())
  analysisId  String
  authorId    String
  timestampMs Int
  content     String   @db.Text
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  author   User     @relation("AnnotationAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([analysisId, createdAt])
  @@index([authorId])
}

model ConsentRecord {
  id                    String        @id @default(uuid())
  userId                String        @unique
  guardianName          String?
  guardianEmail         String?
  guardianRelationship  String?
  consentStatus        ConsentStatus @default(PENDING)
  verificationToken    String?       @unique
  tokenExpiresAt       DateTime?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PrivacyPreferences {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  performanceAnalytics    Boolean  @default(true)
  marketingCommunications Boolean  @default(false)
  coachParentComms        Boolean  @default(true)
  profileVisibility       String   @default("COACHES_PARENTS")
  consentVersion          String   @default("1.0")
  consentedAt             DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GuardianLink {
  id           String   @id @default(uuid())
  parentId     String
  childId      String
  relationship String   // 'mother' | 'father' | 'guardian' | 'other'
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())

  parent User @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  child  User @relation("ChildLinks", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@index([childId])
}

model Conversation {
  id        String   @id @default(uuid())
  subject   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String           @id @default(uuid())
  conversationId String
  senderId       String
  content        String           @db.Text
  visibility     MessageVisibility @default(STANDARD)
  attachmentUrl  String?
  attachmentType String?
  isDeleted     Boolean          @default(false)
  sentAt         DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String   // 'conversation_created_minor' | 'video_uploaded' | etc.
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

model Squad {
  id        String     @id @default(uuid())
  name      String
  coachId   String
  ageGroup  AgeGroup?
  clubName  String?
  isActive  Boolean    @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  coach    User          @relation(fields: [coachId], references: [id], onDelete: Cascade)
  members  SquadMember[]
  sessions Session[]

  @@index([coachId])
}

model Club {
  id            String   @id @default(uuid())
  coachId       String
  name          String
  website       String
  playCricketUrl String
  playCricketId String
  address       String
  postcode      String
  badgeFileName String?
  bannerFileName String?
  badgeImageUrl String?  @db.LongText
  bannerImageUrl String? @db.LongText
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  coach User @relation(fields: [coachId], references: [id], onDelete: Cascade)
  playCricketImports   PlayCricketImport[]
  playCricketStats     PlayCricketPlayerStats[] @relation("ClubPlayCricketStats")
  playCricketMatches   PlayCricketMatch[]   @relation("ClubPlayCricketMatches")
  syncLogs             PlayCricketSyncLog[] @relation("ClubSyncLogs")

  @@index([coachId])
  @@unique([coachId, name])
}

enum PlayCricketImportStatus {
  PENDING  // imported but coach has not acted
  INVITED  // invitation email sent
  LINKED   // matched to existing Koda user
  SKIPPED  // coach chose not to import this player
}

model PlayCricketImport {
  id                  String   @id @default(uuid())
  coachId             String
  clubId              String
  playCricketPersonId String
  playCricketTeamId   String?
  firstName           String
  lastName            String
  email               String?
  dateOfBirth         DateTime?
  battingStyle        String?
  bowlingStyle        String?
  primaryPosition     String?
  rawPayload          Json     // full API response preserved for auditing
  status              PlayCricketImportStatus @default(PENDING)
  linkedUserId        String?  // set if matched to an existing Koda user
  invitedAt           DateTime?
  importedAt          DateTime @default(now())
  updatedAt           DateTime @updatedAt

  coach      User  @relation("CoachPlayCricketImports", fields: [coachId], references: [id], onDelete: Cascade)
  club         Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  linkedUser   User? @relation("LinkedPlayCricketImports", fields: [linkedUserId], references: [id], onDelete: SetNull)
  stats        PlayCricketPlayerStats[]
  inviteToken  PlayCricketInviteToken?

  @@unique([coachId, playCricketPersonId])
  @@index([coachId])
  @@index([clubId])
  @@index([status])
}

/// Player stats from Play-Cricket per season/competition. Cascade delete when Club removed (GDPR).
model PlayCricketPlayerStats {
  id                    String   @id @default(uuid())
  importId              String
  coachId               String
  clubId                String
  playCricketPersonId   String
  playCricketTeamId     String
  teamName              String
  season                String   // "2024"
  competitionType       String   // "Limited Overs" | "T20" | "Declaration"

  // Batting
  battingInnings        Int      @default(0)
  battingNotOuts        Int      @default(0)
  battingRuns           Int      @default(0)
  battingHighest        Int      @default(0)
  battingAverage        Float?
  battingStrikeRate     Float?
  battingFifties        Int      @default(0)
  battingHundreds       Int      @default(0)

  // Bowling
  bowlingOvers          Float    @default(0)
  bowlingWickets        Int      @default(0)
  bowlingRuns           Int      @default(0)
  bowlingAverage        Float?
  bowlingEconomy        Float?
  bowlingBestFigures    String?
  bowlingFiveWickets    Int      @default(0)

  // Fielding
  fieldingCatches       Int      @default(0)
  fieldingStumpings     Int      @default(0)
  fieldingRunOuts       Int      @default(0)

  syncedAt              DateTime @default(now())
  updatedAt             DateTime @updatedAt

  import PlayCricketImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  coach  User              @relation("CoachPlayCricketStats", fields: [coachId], references: [id], onDelete: Cascade)
  club   Club              @relation("ClubPlayCricketStats", fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([importId, season, competitionType])
  @@index([coachId, season])
  @@index([clubId])
  @@index([playCricketPersonId])
}

/// Records each sync run for UI display and debugging.
model PlayCricketSyncLog {
  id                String    @id @default(uuid())
  coachId           String
  clubId            String
  season            String
  status            String    // "PENDING" | "COMPLETE" | "FAILED"
  playersUpserted   Int       @default(0)
  statsRowsUpserted Int       @default(0)
  matchesSynced     Int       @default(0)
  errorMessage      String?   @db.Text
  startedAt         DateTime  @default(now())
  completedAt       DateTime?

  coach User @relation("CoachSyncLogs", fields: [coachId], references: [id], onDelete: Cascade)
  club  Club @relation("ClubSyncLogs", fields: [clubId], references: [id], onDelete: Cascade)

  @@index([coachId, clubId, season])
  @@index([startedAt])
}

/// One row per match. GDPR: cascade delete when Club removed.
model PlayCricketMatch {
  id                  String    @id @default(uuid())
  coachId             String
  clubId              String
  playCricketMatchId  Int       @unique
  matchDate           DateTime?
  homeTeamId          String?
  awayTeamId          String?
  homeTeamName        String?
  awayTeamName        String?
  resultDescription   String?   // "Home team won by 34 runs"
  competitionType     String?
  season              String
  rawPayload          Json

  syncedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  innings PlayCricketMatchInning[]

  coach User @relation("CoachPlayCricketMatches", fields: [coachId], references: [id], onDelete: Cascade)
  club  Club @relation("ClubPlayCricketMatches", fields: [clubId], references: [id], onDelete: Cascade)

  @@index([coachId, season])
  @@index([clubId])
}

/// One row per player per innings per match. Enables form calculations. GDPR: cascade from PlayCricketMatch.
model PlayCricketMatchInning {
  id                  String  @id @default(uuid())
  matchId             String  // FK → PlayCricketMatch
  playCricketPersonId String
  inningsNumber       Int     // 1 or 2
  battingPosition     Int?
  battingRuns         Int?
  battingBalls        Int?
  battingFours        Int?
  battingSixes        Int?
  battingDismissal    String? // "caught", "lbw", "run out", "not out", etc.
  bowlingOvers        Float?
  bowlingMaidens      Int?
  bowlingRuns         Int?
  bowlingWickets      Int?
  fieldingCatches     Int?    @default(0)
  fieldingStumpings   Int?    @default(0)
  fieldingRunOuts     Int?    @default(0)

  match PlayCricketMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, playCricketPersonId, inningsNumber])
  @@index([playCricketPersonId])
  @@index([matchId])
}

model PlayCricketInviteToken {
  id        String   @id @default(uuid())
  importId  String   @unique   // one active token per import record
  coachId   String
  token     String   @unique   // 32-byte hex, used in registration URL
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  import PlayCricketImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  coach  User              @relation("CoachInviteTokens", fields: [coachId], references: [id], onDelete: Cascade)

  @@index([token])
}

model SquadMember {
  id       String   @id @default(uuid())
  squadId  String
  userId   String
  joinedAt DateTime @default(now())

  squad Squad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([squadId, userId])
  @@index([squadId])
  @@index([userId])
}

model Session {
  id          String    @id @default(uuid())
  coachId     String
  squadId     String?
  title       String
  description String?   @db.Text
  scheduledAt DateTime
  endsAt      DateTime
  startedAt   DateTime?
  completedAt DateTime?
  attendees   Int?
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())

  coach   User    @relation("CoachSessions", fields: [coachId], references: [id], onDelete: Cascade)
  players User[] @relation("PlayerSessions")
  squad   Squad? @relation(fields: [squadId], references: [id], onDelete: SetNull)

  @@index([coachId])
  @@index([squadId])
  @@index([scheduledAt])
}

model Collection {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?  @db.Text
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedClips SavedClip[]
  shares     CollectionShare[]

  @@index([userId])
  @@index([createdAt])
}

model CollectionShare {
  id             String   @id @default(uuid())
  collectionId   String
  userId         String
  sharedByUserId String
  createdAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user       User       @relation("CollectionSharesRecipient", fields: [userId], references: [id], onDelete: Cascade)
  sharedBy   User       @relation("CollectionSharesSender", fields: [sharedByUserId], references: [id], onDelete: Cascade)

  @@unique([collectionId, userId])
  @@index([collectionId])
  @@index([userId])
  @@index([sharedByUserId])
}

model SavedClip {
  id           String   @id @default(uuid())
  collectionId String
  videoId      String
  notes        String?  @db.Text
  savedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  video      Video      @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([collectionId, videoId])
  @@index([collectionId])
  @@index([videoId])
  @@index([savedAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  actionUrl String?
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

/// Registered Expo push tokens, one row per device a user has signed in on
/// and granted notification permission -- added in Phase 8 (mobile) so
/// Notification rows (see notifyUser() in lib/notifications.ts) can also
/// trigger a real push, not just populate the in-app list. A user can have
/// several rows (multiple devices); `token` is unique so re-registering the
/// same device just updates its `lastSeenAt` rather than duplicating.
model PushToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PlayerCard {
  id              String    @id @default(uuid())
  userId          String    @unique
  displayName     String
  tier            CardTier  @default(BRONZE)
  role            CardRole  @default(BAT)
  sportIcon       SportIcon @default(BAT_ICON)
  statTec         Int       @default(50)
  statPow         Int       @default(50)
  statTim         Int       @default(50)
  statCon         Int       @default(50)
  statPac         Int       @default(50)
  statFie         Int       @default(50)
  profilePhotoUrl String?
  backgroundUrl   String?
  backgroundMode  BgMode    @default(DEFAULT)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPoints {
  id                 String    @id @default(uuid())
  userId             String    @unique
  totalPoints        Int       @default(0)
  currentSeasonPts   Int       @default(0)
  goldStarCount      Int       @default(0)
  practiceStreakDays Int       @default(0)
  lastPracticeDate   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions PointTransaction[]

  @@index([totalPoints])
  @@index([currentSeasonPts])
}

model PointTransaction {
  id          String   @id @default(uuid())
  userId      String
  points      Int
  reason      String
  referenceId String?
  metadata    Json?
  createdAt   DateTime @default(now())

  userPoints UserPoints @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Platform-wide gamification settings. Single row (id = "default").
model GameSettings {
  id              String          @id @default("default")
  pointEarnSource PointEarnSource @default(BOTH)
  updatedAt       DateTime        @updatedAt
}

model BadgeDefinition {
  id          String      @id @default(uuid())
  key         String      @unique
  name        String
  description String      @db.Text
  rarity      BadgeRarity @default(COMMON)
  iconKey     String
  pointsValue Int         @default(25)
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())

  userBadges UserBadge[]
}

model UserBadge {
  id                String   @id @default(uuid())
  userId            String
  badgeDefinitionId String
  earnedAt          DateTime @default(now())
  referenceId       String?

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeDefinition BadgeDefinition @relation(fields: [badgeDefinitionId], references: [id])

  @@unique([userId, badgeDefinitionId])
  @@index([userId])
  @@index([earnedAt])
}

model League {
  id              String      @id @default(uuid())
  name            String
  scope           LeagueScope @default(CUSTOM)
  clubId          String?
  createdByUserId String
  joinCode        String?     @unique
  ageGroup        AgeGroup?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  createdBy User           @relation("CreatedLeagues", fields: [createdByUserId], references: [id], onDelete: Cascade)
  members   LeagueMember[]
  seasons   LeagueSeason[]

  @@index([scope])
  @@index([clubId])
}

model LeagueSeason {
  id           String    @id @default(uuid())
  leagueId     String
  seasonNumber Int
  startsAt     DateTime
  endsAt       DateTime
  isActive     Boolean   @default(true)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  league  League         @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  entries LeagueEntry[]

  @@unique([leagueId, seasonNumber])
  @@index([leagueId, isActive])
}

model LeagueMember {
  id        String   @id @default(uuid())
  leagueId  String
  userId    String
  joinedAt  DateTime @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId])
  @@index([leagueId])
  @@index([userId])
}

model LeagueEntry {
  id              String   @id @default(uuid())
  leagueSeasonId  String
  userId          String
  points          Int      @default(0)
  goldStars       Int      @default(0)
  topScore        Float?
  analysisCount   Int      @default(0)
  currentRank     Int?
  previousRank    Int?
  updatedAt       DateTime @updatedAt

  leagueSeason LeagueSeason @relation(fields: [leagueSeasonId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueSeasonId, userId])
  @@index([leagueSeasonId, points])
  @@index([userId])
}

model Challenge {
  id              String          @id @default(uuid())
  title           String
  description     String          @db.Text
  status          ChallengeStatus @default(DRAFT)
  shotType        ShotType?
  targetScore     Float?
  targetDimension String?
  targetDimScore  Float?
  prizeDesc       String?
  isPublic        Boolean         @default(false)
  clubId          String?
  createdByUserId String
  startsAt        DateTime
  endsAt          DateTime
  maxEntries      Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  createdBy   User                   @relation("CreatedChallenges", fields: [createdByUserId], references: [id])
  submissions ChallengeSubmission[]

  @@index([status, startsAt])
}

model ChallengeSubmission {
  id               String   @id @default(uuid())
  challengeId      String
  userId           String
  analysisId       String
  score            Float
  isApproved       Boolean  @default(false)
  approvedByUserId String?
  isShowcased      Boolean  @default(false)
  finalRank        Int?
  submittedAt      DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([challengeId, score])
}
