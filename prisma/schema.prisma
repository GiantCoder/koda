generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  PLAYER
  PARENT
  COACH
  ADMIN
}

enum ConsentStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_REQUIRED
}

enum AnalysisStatus {
  QUEUED
  EXTRACTING_FRAMES
  POSE_ANALYSIS
  SHOT_CLASSIFICATION
  GENERATING_FEEDBACK
  COMPLETE
  FAILED
}

enum ShotType {
  COVER_DRIVE
  OFF_DRIVE
  STRAIGHT_DRIVE
  ON_DRIVE
  SWEEP
  REVERSE_SWEEP
  PULL
  HOOK
  CUT
  GLANCE
  DEFENSIVE
  LATE_CUT
  FLICK
  SCOOP
  UNKNOWN
}

enum MessageVisibility {
  STANDARD
  PARENT_VISIBLE
  COACH_ONLY
}

enum AgeGroup {
  UNDER_10
  UNDER_12
  UNDER_14
  UNDER_16
  UNDER_18
  SENIOR
}

enum NotificationType {
  ANALYSIS_COMPLETE
  NEW_MESSAGE
  TEAM_INVITATION
  ACHIEVEMENT_UNLOCKED
  SESSION_REMINDER
  CONSENT_REQUEST
  SYSTEM_ALERT
}

enum CardTier {
  BRONZE
  SILVER
  GOLD
  ELITE
}

enum CardRole {
  BAT
  BWL
  ALL
  WKT
}

enum SportIcon {
  BAT_ICON
  BALL_ICON
  GLOVES_ICON
}

enum BgMode {
  DEFAULT
  UPLOAD
  AI
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?
  name         String?
  displayName  String  @default("")
  firstName    String?
  lastName     String?
  role         Role      @default(PLAYER)
  dateOfBirth  DateTime?
  ageGroup     String?
  clubOrSchool String?
  primaryPosition String?
  battingStyle String?
  bowlingStyle String?
  profileVisibility String @default("COACHES_PARENTS")
  isActive     Boolean   @default(true)
  emailVerified Boolean  @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  consentRecord      ConsentRecord?
  privacyPreferences PrivacyPreferences?
  videos             Video[]
  parentLinks        GuardianLink[] @relation("ParentLinks")
  childLinks         GuardianLink[] @relation("ChildLinks")
  sentMessages       Message[]      @relation("SentMessages")
  conversationParticipants ConversationParticipant[]
  auditLogs          AuditLog[]
  squadMemberships   SquadMember[]
  coachSquads        Squad[]
  sessions           Session[]      @relation("PlayerSessions")
  coachSessions      Session[]     @relation("CoachSessions")
  annotationsAuthored Annotation[] @relation("AnnotationAuthor")
  collections        Collection[]
  notifications      Notification[]
  playerCard         PlayerCard?
}

model Video {
  id              String    @id @default(uuid())
  userId          String
  filename        String
  originalFormat  String
  storagePath     String
  cdnUrl          String?
  fileSizeBytes   BigInt
  durationSeconds Float?
  resolutionWidth Int?
  resolutionHeight Int?
  uploadedAt      DateTime  @default(now())
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis   Analysis?
  savedClips SavedClip[]

  @@index([userId])
}

model Analysis {
  id                   String         @id @default(uuid())
  videoId              String         @unique
  status               AnalysisStatus @default(QUEUED)
  shotType             ShotType?
  shotConfidence       Float?
  gradeOverall         Float?
  gradeLetter          String?
  scoreBacklift        Float?
  scoreWeightTransfer  Float?
  scoreHeadPosition    Float?
  scoreFollowThrough   Float?
  scoreTiming          Float?
  scoreBalance         Float?
  scoreFootwork        Float?
  scoreShotSelection   Float?
  poseDataPath         String?
  skeletonOverlayPath  String?
  coachingTips        Json?
  rawGeminiResponse   Json?
  rawOpenAiResponse   Json?
  analysisVersion     String         @default("1.0")
  processingMs        Int?
  errorMessage        String?        @db.Text
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  annotations Annotation[]

  @@index([status])
}

model Annotation {
  id          String   @id @default(uuid())
  analysisId  String
  authorId    String
  timestampMs Int
  content     String   @db.Text
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  author   User     @relation("AnnotationAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([analysisId, createdAt])
  @@index([authorId])
}

model ConsentRecord {
  id                    String        @id @default(uuid())
  userId                String        @unique
  guardianName          String?
  guardianEmail         String?
  guardianRelationship  String?
  consentStatus        ConsentStatus @default(PENDING)
  verificationToken    String?       @unique
  tokenExpiresAt       DateTime?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PrivacyPreferences {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  performanceAnalytics    Boolean  @default(true)
  marketingCommunications Boolean  @default(false)
  coachParentComms        Boolean  @default(true)
  profileVisibility       String   @default("COACHES_PARENTS")
  consentVersion          String   @default("1.0")
  consentedAt             DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GuardianLink {
  id           String   @id @default(uuid())
  parentId     String
  childId      String
  relationship String   // 'mother' | 'father' | 'guardian' | 'other'
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())

  parent User @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  child  User @relation("ChildLinks", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@index([childId])
}

model Conversation {
  id        String   @id @default(uuid())
  subject   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String           @id @default(uuid())
  conversationId String
  senderId       String
  content        String           @db.Text
  visibility     MessageVisibility @default(STANDARD)
  attachmentUrl  String?
  attachmentType String?
  isDeleted     Boolean          @default(false)
  sentAt         DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String   // 'conversation_created_minor' | 'video_uploaded' | etc.
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

model Squad {
  id        String     @id @default(uuid())
  name      String
  coachId   String
  ageGroup  AgeGroup?
  clubName  String?
  isActive  Boolean    @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  coach    User          @relation(fields: [coachId], references: [id], onDelete: Cascade)
  members  SquadMember[]
  sessions Session[]

  @@index([coachId])
}

model SquadMember {
  id       String   @id @default(uuid())
  squadId  String
  userId   String
  joinedAt DateTime @default(now())

  squad Squad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([squadId, userId])
  @@index([squadId])
  @@index([userId])
}

model Session {
  id          String    @id @default(uuid())
  coachId     String
  squadId     String?
  title       String
  description String?   @db.Text
  scheduledAt DateTime
  endsAt      DateTime
  startedAt   DateTime?
  completedAt DateTime?
  attendees   Int?
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())

  coach   User    @relation("CoachSessions", fields: [coachId], references: [id], onDelete: Cascade)
  players User[] @relation("PlayerSessions")
  squad   Squad? @relation(fields: [squadId], references: [id], onDelete: SetNull)

  @@index([coachId])
  @@index([squadId])
  @@index([scheduledAt])
}

model Collection {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?  @db.Text
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedClips SavedClip[]

  @@index([userId])
  @@index([createdAt])
}

model SavedClip {
  id           String   @id @default(uuid())
  collectionId String
  videoId      String
  notes        String?  @db.Text
  savedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  video      Video      @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([collectionId, videoId])
  @@index([collectionId])
  @@index([videoId])
  @@index([savedAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  actionUrl String?
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model PlayerCard {
  id              String    @id @default(uuid())
  userId          String    @unique
  displayName     String
  tier            CardTier  @default(BRONZE)
  role            CardRole  @default(BAT)
  sportIcon       SportIcon @default(BAT_ICON)
  statTec         Int       @default(50)
  statPow         Int       @default(50)
  statTim         Int       @default(50)
  statCon         Int       @default(50)
  statPac         Int       @default(50)
  statFie         Int       @default(50)
  profilePhotoUrl String?
  backgroundUrl   String?
  backgroundMode  BgMode    @default(DEFAULT)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
